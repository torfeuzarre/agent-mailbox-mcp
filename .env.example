# Nom d'hôte public publié par le Cloudflare Tunnel
DOMAIN=memoire.exemple.com
# En-têtes Host acceptés (protection DNS rebinding), séparés par des virgules :
# - le nom du tunnel (obligatoire)
# - optionnel : IP / nom MagicDNS Tailscale pour un accès direct via le tailnet
# - optionnel : nom Tailscale Funnel (vps.ton-tailnet.ts.net)
# 127.0.0.1 et localhost sont toujours acceptés.
MP_ALLOWED_HOSTS=memoire.exemple.com
#MP_ALLOWED_HOSTS=memoire.exemple.com,100.64.0.10:8765,vps.ton-tailnet.ts.net:8765,vps.ton-tailnet.ts.net

# Jeton du tunnel (Cloudflare Zero Trust > Networks > Tunnels > Create > Docker : valeur après --token)
CLOUDFLARE_TUNNEL_TOKEN=

# IP Tailscale du VPS (`tailscale ip -4`), seulement avec docker-compose.tailscale.yml
#TAILSCALE_IP=100.64.0.10

# Seulement si un client ne sait pas envoyer d'en-tête (voir README) : 1
MP_ALLOW_QUERY_TOKEN=0
MP_LOG_LEVEL=INFO

# --- Transfert de fichiers entre agents (1.1.0) : valeurs par défaut, tout est facultatif ---
#MP_FILES_ENABLED=1            # 0 = désactive put_file/get_file/list_files/delete_file
#MP_FILE_MAX_BYTES=5242880     # 5 Mo après décodage (plafond absolu 25 Mo)
#MP_FILES_QUOTA_BYTES=104857600  # 100 Mo au total
#MP_FILES_MAX_COUNT=200
#MP_FILE_TTL_DAYS=7
#MP_FILE_PURGE_INTERVAL=3600
#MP_FILE_SCAN_PARANOID=0
